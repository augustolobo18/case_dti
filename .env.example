# Porta do servidor HTTP
PORT=3000

# Capacidade máxima de carga do drone (kg)
DRONE_CAPACIDADE_KG=10

# Alcance máximo do drone por carga (quadras) — ida + entregas + volta
DRONE_ALCANCE_QUADRAS=40

# Quantidade de drones da frota (homogênea, instanciada na inicialização).
# Ids são sequenciais e determinísticos: "drone-1".."drone-N". Mudar este valor
# exige reiniciar o servidor — a frota é derivada da config a cada boot, sem persistência.
DRONE_QUANTIDADE=3

# Tamanho da malha da cidade: coordenadas válidas vão de 0 a N (inclusive)
CIDADE_TAMANHO=10

# Coordenada da base (origem/retorno dos drones)
BASE_X=0
BASE_Y=0

# Caminho do arquivo JSON de persistência dos pedidos
PEDIDOS_ARQUIVO=data/pedidos.json
