# Porta do servidor HTTP
PORT=3000

# Capacidade máxima de carga do drone (kg)
DRONE_CAPACIDADE_KG=10

# Alcance máximo do drone por carga (quadras) — ida + entregas + volta
DRONE_ALCANCE_QUADRAS=40

# Quantidade de drones da frota (homogênea, instanciada na inicialização).
# Ids são sequenciais e determinísticos: "drone-1".."drone-N". Mudar este valor
# exige reiniciar o servidor — a frota é derivada da config a cada boot, sem persistência.
DRONE_QUANTIDADE=3

# Tamanho da malha da cidade: coordenadas válidas vão de 0 a N (inclusive)
CIDADE_TAMANHO=10

# Coordenada da base (origem/retorno dos drones)
BASE_X=0
BASE_Y=0

# Caminho do arquivo JSON de persistência dos pedidos
PEDIDOS_ARQUIVO=data/pedidos.json

# Caminho do arquivo JSON de persistência das viagens calculadas (E3)
# Atenção: reduzir DRONE_QUANTIDADE entre reinícios descarta as viagens dos
# drones removidos e devolve os pedidos delas a "pendente" (reconciliação no boot, D27).
VIAGENS_ARQUIVO=data/viagens.json

# Velocidade do drone em voo (quadras por minuto) — E4-2/D14
DRONE_VELOCIDADE_QUADRAS_MIN=1

# Tempo fixo de carregamento na base antes da decolagem (minutos) — E4-2/D14
TEMPO_CARREGAMENTO_MIN=5

# Tempo fixo de entrega por parada (minutos) — E4-2/D14
TEMPO_ENTREGA_MIN=2

# Duração da recarga (minutos por quadra de bateria consumida) — E4-3/D15/D34
RECARGA_MIN_POR_QUADRA=0.5

# Zonas de exclusão aérea (E5-2/D17): retângulos "x1,y1:x2,y2" separados por ";"
# (bordas inclusivas, espaços tolerados). O trajeto contorna as células bloqueadas
# via pathfinding (BFS); a base não pode nascer dentro de uma zona. Vazio por
# padrão — sem zonas, a distância continua exatamente Manhattan.
# Exemplo: ZONAS_EXCLUSAO=2,2:4,5;7,0:8,3
ZONAS_EXCLUSAO=
